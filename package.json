{
  "name": "intranet-frp-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "跨平台 FRP 服务器与本机穿透管理工具",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run icons && npm run typecheck && vite build && tsup",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:desktop": "npm run build && node scripts/electron-smoke.mjs",
    "test:remote": "tsup scripts/remote-smoke.ts --format cjs --out-dir dist/smoke --clean --config false && node dist/smoke/remote-smoke.js",
    "format": "prettier --write src tests scripts *.config.ts package.json tsconfig.json README.md VERIFICATION.md .prettierrc.json .github/workflows/ci.yml",
    "format:check": "prettier --check src tests scripts *.config.ts package.json tsconfig.json README.md VERIFICATION.md .prettierrc.json .github/workflows/ci.yml",
    "test:remote-user": "tsup scripts/remote-process-smoke.ts --format cjs --out-dir dist/process-smoke --clean --config false && node dist/process-smoke/remote-process-smoke.js",
    "test:local-frp": "tsup scripts/local-frp-smoke.ts --format cjs --out-dir dist/local-smoke --clean --config false && node dist/local-smoke/local-frp-smoke.js",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "ssh2": "^1.16.0",
    "tar": "^7.5.0",
    "vue": "^3.5.0",
    "yauzl": "^3.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.1.0"
  },
  "build": {
    "appId": "cn.intranet.frp.desktop",
    "productName": "穿透工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!**/*.node",
      "!node_modules/cpu-features{,/**/*}",
      "!node_modules/ssh2/lib/protocol/crypto/build{,/**/*}",
      "assets/icons/tray*.png",
      "assets/icons/256x256.png"
    ],
    "asarUnpack": [
      "node_modules/ssh2/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "syncDesktopName": true,
      "icon": "assets/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "esbuild": "^0.28.2"
  },
  "author": "Intranet 项目",
  "license": "UNLICENSED",
  "desktopName": "intranet-frp-desktop.desktop"
}
